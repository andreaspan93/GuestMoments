DATABASE_URL="postgresql://guestmoments:guestmoments@localhost:5432/guestmoments"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
OWNER_EMAIL="owner@guestmoments.local"
OWNER_PASSWORD="replace-with-a-long-password"
OWNER_NAME="GuestMoments Owner"
RESEND_API_KEY=""
EMAIL_FROM=""
# Leave the R2 values empty in development to store objects on local disk.
# Production requires a private bucket. Its CORS policy must allow PUT and GET from BETTER_AUTH_URL.
# Leave the Upstash values empty to count upload attempts in Postgres.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Daily Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
# The retention route refuses the job when the value is missing.
CRON_SECRET=""
